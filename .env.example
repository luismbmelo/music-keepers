# Discogs API token
# Get a personal access token from: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=your_discogs_token_here

# Last.fm API credentials
# Get these from: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here
LASTFM_API_SECRET=your_lastfm_api_secret_here

# AcoustID API key (for audio fingerprinting)
# Get this from: https://acoustid.org/api-key
ACOUSTID_API_KEY=your_acoustid_api_key_here
